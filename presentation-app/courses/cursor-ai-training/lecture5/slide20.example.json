{
    "mcpServers": {
        "mongodb": {
            "command": "npx",
            "args": [
                "-y",
                "@mongodb-js/mongodb-mcp-server"
            ],
            "env": {
                "MONGODB_URI": "mongodb://localhost:27017/your-database",
                "MONGODB_MAX_POOL_SIZE": "10"
            }
        }
    }
}